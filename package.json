{
  "name": "sablio",
  "version": "0.1.0",
  "private": true,
  "description": "Sablio : se repérer dans sa journée, ses cours et ses devoirs (prototype)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "captures": "electron . --captures captures",
    "preparer-windows": "node scripts/preparer-windows.mjs",
    "postinstall": "node scripts/copier-sqlite.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test \"tests/*.test.mjs\"",
    "verifier": "npm test && npm run captures",
    "publier": "scripts/publier.sh",
    "verifier-en-ligne": "electron scripts/verifier-en-ligne.js"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "electron": "45.2.3"
  }
}
